# fp-bridge configuration — minimal configuration
# Get your token using scripts/gen-freebuff-token.sh or via your upstream CLI
# For full options, see .env.full-example

# Upstream auth token(s), comma-separated. Empty = bridge mode (clients bring tokens).
AUTH_TOKENS=

# Recommended: safe mode protects your accounts with conservative limits
SAFE_MODE=true

# Server bind address (loopback by default; containers set LISTEN_ADDR=:3457)
LISTEN_ADDR=127.0.0.1:3457

# Log level (debug, info, warn, error)
LOG_LEVEL=info
