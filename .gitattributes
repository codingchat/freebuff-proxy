# LF everywhere: repo + checkout, all platforms (Windows autocrlf noise gone)
* text=auto eol=lf

# Shell scripts must stay LF in the repo (Windows autocrlf would break them)
*.sh text eol=lf

# PowerShell scripts: LF-safe with pwsh/VS Code; explicit for self-documentation
*.ps1 text eol=lf

# dev-only content — never ship in source archives (defense-in-depth; files are untracked/removed)
